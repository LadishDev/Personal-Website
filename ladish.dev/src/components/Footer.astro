---
import { SITE_TITLE } from "../consts";
import { activeSocialLinks } from "../socialLinks";
import SvgIcons from "./SvgIcons.astro";

const today = new Date();
---

<!-- Gradient separator line -->
<div class="footer-separator"></div>

<footer>
	<div class="footer-content">
		<div class="footer-info">
			<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
			<p class="tagline">Building secure, innovative web experiences</p>
		</div>
		
		<div class="social-links">
			{activeSocialLinks.map(link => (
				<a href={link.url} target="_blank" rel="noopener noreferrer" title={link.name}>
					<span class="sr-only">{link.name}</span>
					<svg viewBox="0 0 256 256" aria-hidden="true" width="28" height="28">
						<use href={`#icon-${link.icon}`}/>
					</svg>
				</a>
			))}
		</div>
	</div>
</footer>
<SvgIcons />
<style>
	.footer-separator {
		width: 100%;
		height: 4px;
		background: linear-gradient(90deg, 
			transparent 0%, 
			rgba(167, 139, 250, 0.3) 10%,
			var(--accent) 30%,
			var(--accent-bright) 50%,
			var(--accent) 70%,
			rgba(167, 139, 250, 0.3) 90%,
			transparent 100%
		);
		box-shadow: 0 0 20px rgba(167, 139, 250, 0.4), 0 0 40px rgba(232, 121, 249, 0.2);
		margin-top: 6rem;
	}

	footer {
		padding: 3rem 1.5rem 2rem;
		background: linear-gradient(135deg, rgba(15, 5, 23, 0.6) 0%, rgba(26, 11, 46, 0.6) 100%);
		backdrop-filter: blur(10px);
		color: var(--fg);
		position: relative;
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		text-align: center;
	}

	.footer-info {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.copyright {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.tagline {
		margin: 0;
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.6);
		font-style: italic;
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		background: linear-gradient(135deg, rgba(26, 11, 46, 0.6) 0%, rgba(15, 5, 23, 0.8) 100%);
		border: 2px solid rgba(167, 139, 250, 0.3);
		border-radius: 12px;
		text-decoration: none;
		color: #ffffff;
		transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		backdrop-filter: blur(5px);
	}

	.social-links svg {
		fill: #ffffff;
		transition: all 0.3s ease;
	}

	.social-links a:hover {
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-bright) 100%);
		border-color: var(--accent-bright);
		color: #ffffff;
		transform: translateY(-5px) scale(1.1);
		box-shadow: 0 8px 25px rgba(232, 121, 249, 0.5), 0 0 30px rgba(167, 139, 250, 0.3);
	}

	.social-links a:hover svg {
		fill: #ffffff;
		transform: rotate(5deg);
	}

	@media (min-width: 640px) {
		.footer-content {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}

		.footer-info {
			align-items: flex-start;
		}

		.social-links {
			gap: 1.5rem;
		}
	}

	@media (min-width: 1024px) {
		footer {
			padding: 3.5rem 2rem 2.5rem;
		}

		.social-links a {
			width: 52px;
			height: 52px;
		}
	}
</style>
