---
import HeaderLink from './HeaderLink.astro';
import SvgIcons from './SvgIcons.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
import { activeSocialLinks } from '../socialLinks';
---

<header>
  <nav>
    <!-- Mobile Navigation (Hamburger) -->
    <div class="mobile-nav">
      <div class="left">
        <div class="hamburger" id="hamburger">
          <span class="line"></span>
          <span class="line"></span>
          <span class="line"></span>
        </div>
        <a href="/" class="logo">
          <Image 
            src={logo} 
            alt="Logo" 
            loading="eager"
            width="132"
            height="24"
            style="vertical-align: middle; margin-right: 0.5em;"
          />
        </a>
      </div>
    </div>

    <!-- Desktop Navigation -->
    <div class="desktop-nav nav-style">
      <h2><a href="/">
        <Image 
          src={logo} 
          alt="Logo" 
          loading="eager"
          width="132"
          height="24"
          style="vertical-align: middle; margin-right: 0.5em;"
        />
      </a></h2>
      <div class="internal-links">
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/projects">Projects</HeaderLink>
        <HeaderLink href="/resume">Resume</HeaderLink>
      </div>
      <div class="social-links">
        {activeSocialLinks.map(link => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" title={link.name}>
            <span class="sr-only">{link.name}</span>
            <svg viewBox="0 0 256 256" aria-hidden="true" width="28" height="28">
              <use href={`#icon-${link.icon}`}/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </nav>
  <SvgIcons />
</header>

<!-- Mobile Fullscreen overlay menu -->
<div class="overlay" id="overlay">
  <div class="overlay-content">
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink href="/projects">Projects</HeaderLink>
    <HeaderLink href="/resume">Resume</HeaderLink>
  </div>
</div>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background: linear-gradient(135deg, rgba(15, 5, 23, 0.95) 0%, rgba(26, 11, 46, 0.95) 100%);
    backdrop-filter: blur(20px);
    border-bottom: 2px solid rgba(167, 139, 250, 0.2);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3), 0 0 50px rgba(167, 139, 250, 0.1);
    z-index: 1200;
    display: flex;
    align-items: center;
  }

  /* Ensure body has padding to account for fixed header */
  :global(body) {
    padding-top: 70px;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    width: 100%;
  }

  /* Mobile Navigation Styles */
  .mobile-nav { 
    display: block !important;
    width: 100%;
  }

  .left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hamburger {
    display: block;
    cursor: pointer;
    padding: 5px;
    z-index: 1100;
    transition: transform 0.3s ease;
  }

  .hamburger:hover {
    transform: scale(1.1);
  }

  .hamburger .line {
    display: block;
    width: 28px;
    height: 3px;
    margin: 5px 0;
    background: linear-gradient(90deg, var(--accent), var(--accent-bright));
    transition: 0.3s;
    border-radius: 2px;
    box-shadow: 0 2px 8px rgba(167, 139, 250, 0.3);
  }

  .logo img {
    display: block;
  }

  /* Mobile Overlay */
  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(10, 3, 20, 0.98) 0%, rgba(26, 11, 46, 0.98) 100%);
    backdrop-filter: blur(10px);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1000;
  }

  .overlay.show {
    display: flex;
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: center;
  }

  .overlay-content a {
    font-size: 2rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    padding: 0.5rem 1rem;
  }

  .overlay-content a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-bright));
    transition: width 0.3s ease;
    border-radius: 2px;
  }

  .overlay-content a:hover {
    color: var(--accent-bright);
    transform: translateX(10px);
  }

  .overlay-content a:hover::after {
    width: 80%;
  }

  /* Desktop Navigation Styles - Hidden on Mobile */
  .desktop-nav { 
    display: none !important;
  }

  .nav-style {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }

  .desktop-nav a {
    padding: 1em 0.75em;
    color: rgba(255, 255, 255, 0.85);
    border-bottom: 3px solid transparent;
    text-decoration: none;
    transition: all 0.3s ease;
    font-weight: 500;
    position: relative;
  }

  .desktop-nav a:hover {
    color: var(--accent-bright);
  }

  .desktop-nav a.active {
    text-decoration: none;
    border-bottom-color: transparent;
    color: var(--accent-bright);
  }

  .desktop-nav a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-bright));
    border-radius: 2px;
    box-shadow: 0 0 10px var(--accent-bright);
  }

  .social-links,
  .social-links a {
    display: flex;
  }

  .social-links a {
    transition: all 0.3s ease;
    opacity: 0.9;
    color: #ffffff;
  }

  .social-links a:hover {
    opacity: 1;
    transform: translateY(-2px);
    filter: drop-shadow(0 4px 12px rgba(232, 121, 249, 0.6));
  }

  .social-links svg {
    transition: all 0.3s ease;
    fill: #ffffff;
  }

  .social-links a:hover svg {
    fill: var(--accent-bright);
  }

  .internal-links {
    display: flex;
    gap: 1rem;
  }

  /* Responsive Breakpoint */
  @media screen and (min-width: 721px) {
    .mobile-nav { 
      display: none !important;
    }
    .desktop-nav { 
      display: flex !important;
      width: 100%;
    }
    .overlay {
      display: none !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const hamburger = document.getElementById("hamburger");
    const overlay = document.getElementById("overlay");

    hamburger?.addEventListener("click", () => {
      overlay?.classList.toggle("show");
    });

    // Close overlay when clicking on overlay background
    overlay?.addEventListener("click", (e) => {
      if (e.target === overlay) {
        overlay.classList.remove("show");
      }
    });

    // Close overlay on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay?.classList.contains("show")) {
        overlay.classList.remove("show");
      }
    });
  });
</script>
